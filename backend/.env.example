# Copia este archivo a .env para desarrollo local. No versiones .env.
NODE_ENV=development
PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_STORAGE_BUCKET=fondea-backend-checks
ALLOWED_ORIGINS=http://localhost:3000
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Solo para verify:integration: access token de un usuario de prueba confirmado.
# No es la clave publicable ni un refresh token. No se imprime en los logs.
INTEGRATION_ACCESS_TOKEN=
# Alternativa: el script puede iniciar y cerrar una sesión con un usuario de prueba.
# INTEGRATION_EMAIL=
# INTEGRATION_PASSWORD=
